# Defaults for docker compose. Override locally via shell env or a git-ignored .env.local (docker compose --env-file).

# Kafka (KRaft). The cluster id is written into the data volume, so it must stay fixed across restarts.
KAFKA_CLUSTER_ID=bWluaS13c2EtY2x1c3Rlcg
DLR_TOPIC_PARTITIONS=6
KAFKA_LOG_RETENTION_HOURS=168

# ClickHouse
CLICKHOUSE_DB=miniwsa
CLICKHOUSE_USER=miniwsa
CLICKHOUSE_PASSWORD=miniwsa

# Application
APP_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75

# Kafka UI web console port
KAFKA_UI_PORT=8090

# Split deployment (docker-compose.split.yml)
INGEST_REPLICAS=3
PROCESSING_REPLICAS=2
ANALYTICS_REPLICAS=1
