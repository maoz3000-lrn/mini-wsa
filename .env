# Docker Compose variables (substituted into the compose files); the app itself does not read this file.
# Override via shell env, or a git-ignored .env.local: docker compose --env-file .env --env-file .env.local ...

# Kafka (KRaft). The cluster id is written into the data volume, so it must stay fixed across restarts.
KAFKA_CLUSTER_ID=bWluaS13c2EtY2x1c3Rlcg
# Broker-wide fallback retention (topics below set their own)
KAFKA_LOG_RETENTION_HOURS=168

# Topics (applied by kafka-init on every `up`)
# dlr-raw: buffer + replay source; partitions = max consumer parallelism (processing replicas x concurrency)
DLR_TOPIC_PARTITIONS=6
# 7 days: covers a long consumer outage and re-processing after a fix
DLR_TOPIC_RETENTION_MS=604800000
# size cap per partition (1 GiB) so an attack flood cannot fill the disk
DLR_TOPIC_RETENTION_BYTES=1073741824
# dlr-raw.DLT: low volume, one partition keeps dead letters in order; kept 30 days for inspection and replay
DLT_TOPIC_PARTITIONS=1
DLT_TOPIC_RETENTION_MS=2592000000

# ClickHouse
CLICKHOUSE_DB=miniwsa
CLICKHOUSE_USER=miniwsa
CLICKHOUSE_PASSWORD=miniwsa

# Application
APP_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75

# Kafka UI web console port
KAFKA_UI_PORT=8090

# ClickHouse UI (CH-UI) web console port
CLICKHOUSE_UI_PORT=3488

# Split deployment (docker-compose.split.yml)
INGEST_REPLICAS=3
PROCESSING_REPLICAS=2
ANALYTICS_REPLICAS=1
